#!/bin/bash
set -eu
APP_HOME=/vol1/1000/OusePet
COMPOSE=(docker compose --project-directory "$APP_HOME" -f "$APP_HOME/compose.yaml" -f "$APP_HOME/compose.gpu.yaml")
case "${1:-}" in
  start)
    "${COMPOSE[@]}" up -d --no-build
    for attempt in $(seq 1 30); do
      if curl -fsS --max-time 2 http://127.0.0.1:8766/api/health >/dev/null; then exit 0; fi
      sleep 1
    done
    exit 1
    ;;
  stop) "${COMPOSE[@]}" stop ;;
  status)
    if [ "$(docker inspect --format '{{.State.Running}}' ousepet-album 2>/dev/null)" = true ]; then exit 0; fi
    exit 3
    ;;
  *) exit 1 ;;
esac
